# Create an application at https://discord.com/developers/applications
# Bot → Reset Token, then paste it here.
DISCORD_TOKEN=your_bot_token_here

# General Information → Application ID
DISCORD_CLIENT_ID=your_application_id_here

# Optional: register slash commands instantly in one server while developing.
# Right-click the server icon → Copy Server ID (Developer Mode must be on).
DISCORD_GUILD_ID=

# Optional fallback prefix for text commands. Slash commands always work.
COMMAND_PREFIX=!
